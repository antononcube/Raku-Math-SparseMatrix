use v6.d;

# use lib <. lib>;
use Math::SparseMatrix;
use Math::SparseMatrix::CSC;
use Math::SparseMatrix::CSR;
use Math::SparseMatrix::Utilities;
use Test;

my $nrow = 5;
my $ncol = 8;
my $density = 0.25;
my $tol = 0.01;

plan *;

# 1
subtest {
    my $matrix = generate-random-sparse-matrix(:$nrow, :$ncol, :$density, :$tol):!decorated;
    isa-ok
            $matrix,
            Math::SparseMatrix::CSR,
            "Expected type after CSR creation";

    isa-ok
            Math::SparseMatrix.to-csc($matrix),
            Math::SparseMatrix::CSC:D,
            "Expected type after CSR conversion to CSC";

    my $matrix2 = Math::SparseMatrix.to-csc($matrix);
    my $matrix3 = Math::SparseMatrix.to-csr($matrix2);

    is
            $matrix3.eqv($matrix),
            True,
            'Expected round trip equivalence';
}

# 2
subtest {
    my $matrix = Math::SparseMatrix::CSC.new(
            values => [10, 20, 30, 40],
            row-index => [2, 0, 2, 1],
            col-ptr => [0, 2, 2, 3, 4],
            nrow => 4,
            ncol => 4,
            implicit-value => -1);
    my $csr = Math::SparseMatrix.to-csr($matrix);

    is-deeply $csr.row-ptr, [0, 1, 2, 4, 4],
            'Expected row pointers for empty and populated CSC columns';
    is-deeply $csr.col-index, [0, 3, 0, 2],
            'Expected column indexes ordered within each CSR row';
    is-deeply $csr.values, [20, 40, 10, 30],
            'Expected values aligned with the CSR indexes';
    is $csr.implicit-value, -1, 'Expected implicit value preservation';
}

done-testing;
